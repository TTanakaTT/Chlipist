#!/bin/sh

set -eu

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift' | tr '\n' ' ')

if [ -z "$files" ]; then
  exit 0
fi
for file in $files; do
  if ! git diff --quiet -- "$file"; then
    echo "pre-commit: staged Swift file '$file' also has unstaged changes." >&2
    echo "pre-commit: aborting to avoid staging unrelated unstaged hunks after formatting." >&2
    exit 1
  fi
done
make format FILES="$files"
make lint FILES="$files"
git add -- $files
